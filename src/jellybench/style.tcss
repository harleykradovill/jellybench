$primary: #fcc179;
$surface: #202020;

#logo {
    width: 100%;
    color: $primary;
    text-style: bold;
    margin-top: 1;
    content-align: center middle;
}

/* ================== */
/* Universal Elements */
/* ================== */
.input {
    width: 30;
    margin-top: 1;
}

.input:focus {
    background: $primary;
    color: $background;
}

.btn {
    width: 30;
    margin-top: 1;
}

.btn:focus {
    background: $primary;
    color: $background;
}

.footer {
    dock: bottom;
    width: 100%;
    height: 1;
    color: $primary;
    background: $surface;
    content-align: right middle;
}

/* ================ */
/* Main Menu Screen */
/* ================ */

#menu-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

.optionslist {
    width: 30;
    height: auto;
}

.optionslist ListItem {
    height: 1;
}

.optionslist ListItem Label {
    width: 100%;
    text-align: center;
    color: $primary;
}

/* ==================== */
/* Configuration Screen */
/* ==================== */

#config-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#config-container Label {
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

/* ========================= */
/* Server Information Screen */
/* ========================= */

#server-container {
    width: 100%;
    height: auto;
    align: center top;
    margin-top: 1;
}

#server-container .info-label {
    color: $primary;
    text-style: bold;
    margin-top: 1;
}

#server-container .info-sub {
    color: $primary;
    margin-top: 1;
}

#server-container .info-value {
    margin-top: 0;
}